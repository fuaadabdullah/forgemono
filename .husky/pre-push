#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🚀 Running pre-push checks..."

# Run tests
npm test || {
  echo "❌ Tests failed. Fix the issues before pushing."
  exit 1
}

# Check for console.log statements (except in tests)
if grep -r "console\.log" src apps --include="*.ts" --include="*.tsx" --exclude-dir="*.test.*" --exclude-dir="node_modules" | grep -v "// console.log allowed"; then
  echo "❌ Found console.log in source files. Remove before pushing."
  exit 1
fi

# Check for leftover TODO comments without issue links
if grep -r "TODO\|FIXME\|HACK\|XXX" src apps --include="*.ts" --include="*.tsx" --exclude-dir="node_modules" | grep -v "#ISSUE-" | grep -v "https://"; then
  echo "❌ TODO comments must include issue tracker link."
  exit 1
fi

echo "✅ All checks passed!"
