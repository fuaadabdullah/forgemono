{
  "buildCommand": "rm -rf .next/cache && npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "functions": {
    "app/**/*.js": {
      "maxDuration": 10
    }
  },
  "env": {
    "BACKEND_URL": "https://goblin-backend.fly.dev"
  },
  "rewrites": [
    {
      "source": "/chat/:path*",
      "destination": "https://goblin-backend.fly.dev/chat/:path*"
    },
    {
      "source": "/health",
      "destination": "https://goblin-backend.fly.dev/health"
    }
  ]
}

