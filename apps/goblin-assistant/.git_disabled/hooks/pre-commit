#!/bin/sh

# Pre-commit hook for goblin-assistant frontend security validation
# This hook runs before each commit to ensure security standards are met

echo "🔒 Running pre-commit security validation..."

# Run environment validation
echo "Checking environment security..."
npx tsx scripts/validate-env.ts
if [ $? -ne 0 ]; then
    echo "❌ Environment validation failed. Please fix security issues before committing."
    exit 1
fi

# Run linting
echo "Running ESLint..."
npm run lint
if [ $? -ne 0 ]; then
    echo "❌ Linting failed. Please fix linting issues before committing."
    exit 1
fi

# Run type checking
echo "Running TypeScript type check..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
    echo "❌ Type checking failed. Please fix type errors before committing."
    exit 1
fi

echo "✅ All pre-commit checks passed!"
exit 0
